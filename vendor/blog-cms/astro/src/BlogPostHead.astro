---
import { headModel } from "@blog-cms/astro/head";
import type { HeadPost, SiteSettings } from "@blog-cms/astro/head";

interface Props {
  post: HeadPost;
  site: SiteSettings;
}

const model = headModel(Astro.props.post, Astro.props.site);
---

<title>{model.title}</title>
<meta name="description" content={model.description} />
<link rel="canonical" href={model.canonical} />
{model.noindex ? <meta name="robots" content="noindex" /> : null}
<meta property="og:type" content="article" />
<meta property="og:title" content={model.title} />
<meta property="og:description" content={model.description} />
<meta property="og:url" content={model.canonical} />
<meta property="og:image" content={model.image} />
<meta property="og:image:alt" content={model.imageAlt} />
<meta property="og:site_name" content={model.siteName} />
<meta property="article:published_time" content={model.publishedTime} />
<meta property="article:modified_time" content={model.modifiedTime} />
{model.tags.map((tag) => <meta property="article:tag" content={tag} />)}
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" is:inline set:html={model.jsonLd} />
