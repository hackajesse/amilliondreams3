---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title = 'A Million Dreams: Tech, AI & Process Consulting',
  description = 'Jesse Biroscak helps companies with SEO and AI search, business process improvement, workflow automation, custom software, and emergency tech delivery. Project, hourly, or retainer. Based in Boston; work remotely or on-site with teams across the U.S.',
  ogImage = '/og-image.png',
  canonical = 'https://amilliondreams.llc',
} = Astro.props;

const fullTitle = title.includes('A Million Dreams') ? title : `${title} | A Million Dreams`;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["Organization", "ProfessionalService"],
  "name": "A Million Dreams LLC",
  "alternateName": "A Million Dreams",
  "url": "https://amilliondreams.llc",
  "logo": "https://amilliondreams.llc/logo-lantern.png",
  "founder": {
    "@type": "Person",
    "name": "Jesse Biroscak",
    "sameAs": [
      "https://www.linkedin.com/in/jessebiroscak/",
      "https://www.linkedin.com/company/a-million-dreams-llc/"
    ]
  },
  "description": description,
  "areaServed": "US",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Boston",
    "addressRegion": "MA",
    "addressCountry": "US"
  },
  "serviceType": [
    "SEO and Generative Engine Optimization",
    "Business Process Improvement and Workflow Automation",
    "Custom Software Development",
    "User Experience Design",
    "Emergency Tech Delivery",
    "AI and Technology Consulting"
  ]
});
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`https://amilliondreams.llc${ogImage}`} />
    <meta property="og:site_name" content="A Million Dreams LLC" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`https://amilliondreams.llc${ogImage}`} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={jsonLd} />

    <!-- Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <slot />
    <script>
      // Scroll-reveal
      const observer = new IntersectionObserver(
        (entries) => entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            observer.unobserve(e.target);
          }
        }),
        { threshold: 0.12 }
      );
      document.querySelectorAll('[data-reveal]').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
