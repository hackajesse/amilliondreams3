---
import Listing from '../../../components/blog/Listing.astro';
import { pageHref, paginate } from '../../../lib/paging.ts';
import { publishedPosts } from '../../../lib/posts.ts';
import { site } from '../../../blog/site.ts';

export async function getStaticPaths() {
  const chunks = paginate(await publishedPosts(), site.pageSize);
  return chunks.slice(1).map((posts, index) => ({
    params: { page: String(index + 2) },
    props: { posts, page: index + 2, pages: chunks.length },
  }));
}

const { posts, page, pages } = Astro.props;
const hrefFor = (number: number) => pageHref('/blog', number);
---

<Listing heading="Blog" posts={posts} page={page} pages={pages} hrefFor={hrefFor} />
