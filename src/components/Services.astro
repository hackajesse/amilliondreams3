---
const services = [
  {
    id: 'growth',
    tag: '01',
    title: 'Growth & Visibility',
    subtitle: 'SEO · GEO · AEO',
    body: 'Need to show up in Google and in tools like ChatGPT, Claude, and Perplexity? I handle the research, on-page work, technical fixes, and content. Every project includes before/after benchmarks so you can see what moved.',
    detail: 'Keyword research, on-page, technical audit, content design, link strategy, citations in AI answers, answer-engine optimization.',
  },
  {
    id: 'automation',
    tag: '02',
    title: 'Automation & Workflows',
    subtitle: 'Python · Integrations · Lean Six Sigma',
    body: 'Tedious admin, slow billing, or data work nobody wants to touch? I write the scripts and wire the integrations. If the process itself is broken, I use Lean Six Sigma to fix that first.',
    detail: 'Web scraping, social content pipelines, billing automation, ERP/CRM integration, API wiring, reporting dashboards.',
  },
  {
    id: 'product',
    tag: '03',
    title: 'Product & Custom Software',
    subtitle: 'Research · UX/UI · Mobile · LLMs',
    body: 'Need an app or product feature built? I cover research, UX/UI, and development (including LLM features), end-to-end or inside your existing team.',
    detail: 'iOS apps, web apps, AI feature integration, design systems, prototype to production.',
  },
  {
    id: 'emergency',
    tag: '04',
    title: 'Emergency Tech Delivery',
    subtitle: 'PM · UI Rescue · QA',
    body: 'Project in trouble or on a hard deadline? I step in for product management, UI redesign, and QA on complex or regulated systems.',
    detail: 'Federal, healthcare, finance. Tight deadlines, sensitive data, messy systems. Been there.',
  },
];
---

<section class="section services" id="services" aria-labelledby="services-heading">
  <div class="container">
    <div class="services__header" data-reveal>
      <span class="section-eyebrow">What I do</span>
      <h2 class="section-heading" id="services-heading">Services</h2>
      <p class="section-sub">
        Flat-fee projects. No retainer floor. We scope the work, then I do it.
      </p>
    </div>

    <div class="services__grid">
      {services.map((s, i) => (
        <article class="service-card" data-reveal data-delay={String(i + 1)}>
          <span class="service-card__tag">{s.tag}</span>
          <h3 class="service-card__title">{s.title}</h3>
          <p class="service-card__subtitle">{s.subtitle}</p>
          <p class="service-card__body">{s.body}</p>
          <p class="service-card__detail">{s.detail}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.services {
  background: var(--color-navy-mid);
}

.services__header {
  margin-bottom: var(--space-12);
}

.services__grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 480px), 1fr));
  gap: 1px;
  background: rgba(201, 168, 76, 0.1);
  border: 1px solid rgba(201, 168, 76, 0.1);
}

.service-card {
  background: var(--color-navy-mid);
  padding: var(--space-8) var(--space-8) var(--space-8);
  transition: background var(--duration-base) var(--ease-out);
}
.service-card:hover {
  background: var(--color-navy-light);
}

.service-card__tag {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-gold-dim);
  letter-spacing: 0.12em;
}

.service-card__title {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: 600;
  color: var(--color-white);
  margin-top: var(--space-3);
  line-height: 1.2;
}

.service-card__subtitle {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--color-copper);
  letter-spacing: 0.1em;
  margin-top: var(--space-2);
}

.service-card__body {
  font-size: var(--text-base);
  color: var(--color-white-dim);
  margin-top: var(--space-4);
  line-height: 1.7;
}

.service-card__detail {
  font-size: var(--text-sm);
  color: rgba(244, 240, 232, 0.44);
  margin-top: var(--space-4);
  line-height: 1.65;
  font-style: italic;
  border-top: var(--border-subtle);
  padding-top: var(--space-4);
}
</style>
